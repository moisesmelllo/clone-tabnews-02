{
  "name": "clone-tabnews-02",
  "version": "1.0.0",
  "description": "Refazendo o projeto a fim de absorver ainda mais os conhecimentos",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && (trap 'npm run services:stop' INT TERM HUP; next dev)",
    "test": "npm run services:up && concurrently --kill-others --success command-jest -n next,jest \"next dev\" \"dotenv -e .env.development -- jest --runInBand\"",
    "test:watch": "dotenv -e .env.development -- jest --runInBand --watchAll --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings=0",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "dedent": "^1.7.2",
    "next": "^16.2.1",
    "next-connect": "^1.0.0",
    "nodemailer": "8.0.4",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "2.4.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "10.4.0",
    "@next/eslint-plugin-next": "^16.2.1",
    "@secretlint/formatter": "^11.4.0",
    "@secretlint/secretlint-rule-aws": "^11.4.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.0",
    "baseline-browser-mapping": "^2.10.11",
    "commitizen": "^4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "17.3.1",
    "dotenv-cli": "11.0.0",
    "dotenv-expand": "12.0.3",
    "eslint": "10.1.0",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "node-pg-migrate": "^8.0.4",
    "prettier": "3.8.1",
    "secretlint": "^11.4.0",
    "set-cookie-parser": "3.1.0",
    "typescript": "^6.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
