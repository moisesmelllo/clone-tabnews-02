{
  "name": "clone-tabnews-02",
  "version": "1.0.0",
  "description": "Refazendo o projeto a fim de absorver ainda mais os conhecimentos",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && (trap 'npm run services:stop' INT TERM HUP; next dev)",
    "test": "npm run services:up && concurrently --kill-others --success command-jest -n next,jest \"next dev\" \"dotenv -e .env.development -- jest --runInBand\"",
    "test:watch": "dotenv -e .env.development -- jest --runInBand --watchAll --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings=0",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.2",
    "cookie": "1.0.2",
    "dedent": "^1.7.1",
    "dotenv": "17.2.3",
    "dotenv-expand": "12.0.3",
    "next": "^16.0.7",
    "next-connect": "^1.0.0",
    "nodemailer": "7.0.5",
    "pg": "8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "swr": "2.3.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@faker-js/faker": "9.7.0",
    "@secretlint/secretlint-rule-preset-recommend": "11.2.5",
    "commitizen": "^4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "8.57.1",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "node-pg-migrate": "^7.6.1",
    "prettier": "3.7.4",
    "secretlint": "11.2.5",
    "set-cookie-parser": "2.7.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
